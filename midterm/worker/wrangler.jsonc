{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trend-signals",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // The page template is shared with the Python version; import .html files as text.
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "kv_namespaces": [
    // Created with: npx wrangler kv namespace create ANALYSES
    { "binding": "ANALYSES", "id": "a58f3438df374fe8b85bcb8d4f5524d3" }
  ],
  "observability": { "enabled": true },
  // Paid Jev: the free tier refuses Cloudflare's servers (FreeUsageLimitError). About $0.04 per 1M input tokens.
  "vars": { "JEV_MODEL": "jev-1.13", "JEV_FOR_INTENT": "1" },
  // Run in one fixed region (Google Cloud Seoul). Otherwise the Worker runs wherever the
  // visitor's nearest Cloudflare data center is, and Gemini refuses some of those
  // locations ("User location is not supported").
  "placement": { "mode": "targeted", "region": "gcp:asia-northeast3" }
  // Secrets (never in this file): npx wrangler secret put OPENROUTER_API_KEY
  //                                npx wrangler secret put SEARCH_PASSWORD
  //                                npx wrangler secret put OPENCODE_API_KEY   (Jev, optional)
  //                                npx wrangler secret put GEMINI_API_KEY     (news via Google Search)
}
